.pytest_cache/
__pycache__/

# ESP-IDF built binaries (nunca commitar isso)
build/
build_*_*/
sdkconfig
sdkconfig.old

# Outros arquivos temporários do ESP-IDF
managed_components/
dependencies.lock

# Pastas de IDE (opcional, mas recomendado)
.vscode/
.idea/
# Utilitários: credenciais e dados gerados nos experimentos
utilitarios/config/env.txt
utilitarios/dados/*
!utilitarios/dados/.gitkeep

# Cópia antiga de um repositório git (não versionar)
.git copy/
